<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/youtube_tv_keyboard_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/yt_tv_keyboard_container_bg"
    android:clipChildren="false">

    <!-- Row 1: A - F -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button android:id="@+id/yt_key_a" style="@style/YouTubeTVKeyboardKey" android:text="A" android:nextFocusUp="@+id/lb_search_bar" />
        <Button android:id="@+id/yt_key_b" style="@style/YouTubeTVKeyboardKey" android:text="B" android:nextFocusUp="@+id/lb_search_bar" />
        <Button android:id="@+id/yt_key_c" style="@style/YouTubeTVKeyboardKey" android:text="C" android:nextFocusUp="@+id/lb_search_bar" />
        <Button android:id="@+id/yt_key_d" style="@style/YouTubeTVKeyboardKey" android:text="D" android:nextFocusUp="@+id/lb_search_bar" />
        <Button android:id="@+id/yt_key_e" style="@style/YouTubeTVKeyboardKey" android:text="E" android:nextFocusUp="@+id/lb_search_bar" />
        <Button android:id="@+id/yt_key_f" style="@style/YouTubeTVKeyboardKey" android:text="F" android:nextFocusUp="@+id/lb_search_bar" android:nextFocusRight="@+id/lb_results_frame" />
    </LinearLayout>

    <!-- Row 2: G - L -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button android:id="@+id/yt_key_g" style="@style/YouTubeTVKeyboardKey" android:text="G" />
        <Button android:id="@+id/yt_key_h" style="@style/YouTubeTVKeyboardKey" android:text="H" />
        <Button android:id="@+id/yt_key_i" style="@style/YouTubeTVKeyboardKey" android:text="I" />
        <Button android:id="@+id/yt_key_j" style="@style/YouTubeTVKeyboardKey" android:text="J" />
        <Button android:id="@+id/yt_key_k" style="@style/YouTubeTVKeyboardKey" android:text="K" />
        <Button android:id="@+id/yt_key_l" style="@style/YouTubeTVKeyboardKey" android:text="L" android:nextFocusRight="@+id/lb_results_frame" />
    </LinearLayout>

    <!-- Row 3: M - R -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button android:id="@+id/yt_key_m" style="@style/YouTubeTVKeyboardKey" android:text="M" />
        <Button android:id="@+id/yt_key_n" style="@style/YouTubeTVKeyboardKey" android:text="N" />
        <Button android:id="@+id/yt_key_o" style="@style/YouTubeTVKeyboardKey" android:text="O" />
        <Button android:id="@+id/yt_key_p" style="@style/YouTubeTVKeyboardKey" android:text="P" />
        <Button android:id="@+id/yt_key_q" style="@style/YouTubeTVKeyboardKey" android:text="Q" />
        <Button android:id="@+id/yt_key_r" style="@style/YouTubeTVKeyboardKey" android:text="R" android:nextFocusRight="@+id/lb_results_frame" />
    </LinearLayout>

    <!-- Row 4: S - X -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button android:id="@+id/yt_key_s" style="@style/YouTubeTVKeyboardKey" android:text="S" />
        <Button android:id="@+id/yt_key_t" style="@style/YouTubeTVKeyboardKey" android:text="T" />
        <Button android:id="@+id/yt_key_u" style="@style/YouTubeTVKeyboardKey" android:text="U" />
        <Button android:id="@+id/yt_key_v" style="@style/YouTubeTVKeyboardKey" android:text="V" />
        <Button android:id="@+id/yt_key_w" style="@style/YouTubeTVKeyboardKey" android:text="W" />
        <Button android:id="@+id/yt_key_x" style="@style/YouTubeTVKeyboardKey" android:text="X" android:nextFocusRight="@+id/lb_results_frame" />
    </LinearLayout>

    <!-- Row 5: Y, Z, 1 - 4 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button android:id="@+id/yt_key_y" style="@style/YouTubeTVKeyboardKey" android:text="Y" />
        <Button android:id="@+id/yt_key_z" style="@style/YouTubeTVKeyboardKey" android:text="Z" />
        <Button android:id="@+id/yt_key_1" style="@style/YouTubeTVKeyboardKey" android:text="1" />
        <Button android:id="@+id/yt_key_2" style="@style/YouTubeTVKeyboardKey" android:text="2" />
        <Button android:id="@+id/yt_key_3" style="@style/YouTubeTVKeyboardKey" android:text="3" />
        <Button android:id="@+id/yt_key_4" style="@style/YouTubeTVKeyboardKey" android:text="4" android:nextFocusRight="@+id/lb_results_frame" />
    </LinearLayout>

    <!-- Row 6: 5 - 0 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button android:id="@+id/yt_key_5" style="@style/YouTubeTVKeyboardKey" android:text="5" />
        <Button android:id="@+id/yt_key_6" style="@style/YouTubeTVKeyboardKey" android:text="6" />
        <Button android:id="@+id/yt_key_7" style="@style/YouTubeTVKeyboardKey" android:text="7" />
        <Button android:id="@+id/yt_key_8" style="@style/YouTubeTVKeyboardKey" android:text="8" />
        <Button android:id="@+id/yt_key_9" style="@style/YouTubeTVKeyboardKey" android:text="9" />
        <Button android:id="@+id/yt_key_0" style="@style/YouTubeTVKeyboardKey" android:text="0" android:nextFocusRight="@+id/lb_results_frame" />
    </LinearLayout>

    <!-- Row 7: Action Controls (Space, Backspace, Clear, Search) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="2dp">
        <Button
            android:id="@+id/yt_key_space"
            style="@style/YouTubeTVKeyboardActionKey"
            android:layout_width="72dp"
            android:text="SPACE" />
        <Button
            android:id="@+id/yt_key_backspace"
            style="@style/YouTubeTVKeyboardActionKey"
            android:layout_width="66dp"
            android:text="⌫ DEL" />
        <Button
            android:id="@+id/yt_key_clear"
            style="@style/YouTubeTVKeyboardActionKey"
            android:layout_width="64dp"
            android:text="CLEAR" />
        <Button
            android:id="@+id/yt_key_search"
            style="@style/YouTubeTVKeyboardActionKey"
            android:layout_width="74dp"
            android:background="@drawable/yt_tv_key_search_background"
            android:textColor="@color/yt_tv_key_search_text_color"
            android:nextFocusRight="@+id/lb_results_frame"
            android:text="SEARCH" />
    </LinearLayout>

</LinearLayout>
