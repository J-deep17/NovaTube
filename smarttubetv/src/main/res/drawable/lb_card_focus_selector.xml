<?xml version="1.0" encoding="utf-8"?>
<!-- YouTube TV card focus selector: white border on focus, transparent when unselected -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true" android:drawable="@drawable/lb_card_focus_border"/>
    <item android:state_focused="true" android:drawable="@drawable/lb_card_focus_border"/>
    <item android:drawable="@android:color/transparent"/>
</selector>

